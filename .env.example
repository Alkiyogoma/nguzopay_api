# ── NguzoPay API ────────────────────────────────────────────────
# Copy to .env for local work. Sandbox/production values live in the
# server's secret store, never in git (see docs/04-deployment).
APP_NAME=NguzoPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The Next.js portal (CORS, OAuth/email/reset redirects).
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# IPs of the Next.js server(s) that proxy API calls (they send X-Forwarded-For).
TRUSTED_PROXIES=127.0.0.1,::1

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local quick start uses SQLite. For Postgres (as in CI and production):
#   docker compose up -d   (in this folder), then:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=nguzopay
# DB_USERNAME=nguzopay
# DB_PASSWORD=nguzopay
DB_CONNECTION=sqlite

SESSION_DRIVER=array
FILESYSTEM_DISK=local
KYC_DISK=local

# Queues and cache. With Redis running (docker compose), switch to:
#   QUEUE_CONNECTION=redis  CACHE_STORE=redis  and run `php artisan horizon`.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@nguzopay.co.tz"
MAIL_FROM_NAME="NguzoPay"

# ── Authentication ─────────────────────────────────────────────
AUTH_TOKEN_TTL_MINUTES=10080
OTP_TTL_MINUTES=5

# Google: https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: ${APP_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers (OAuth App)
#   Callback URL: ${APP_URL}/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── SMS (DarSMS) ────────────────────────────────────────────────
# "log" writes SMS (including OTP codes) to storage/logs/laravel.log.
# "darsms" sends for real. Try it with: php artisan nguzopay:sms-test 07XXXXXXXX
SMS_DRIVER=log
# Must be a sender ID approved on your DarSMS account. Until NGUZOPAY is
# approved, use one that is (DarSMS's sample uses DARSMS).
SMS_DEFAULT_SENDER_ID=NGUZOPAY
DARSMS_BASE_URL=https://dev.darsms.co.tz/api/v1
# Secret: keep it in .env / the server's secret store, never in git or chat.
DARSMS_API_KEY=
# api_key → "X-API-Key: <key>" (DarSMS sample)  |  bearer → "Authorization: Bearer <key>"
DARSMS_AUTH=api_key

# ── Secrets vault (provider credentials) ────────────────────────
# Generate with: php artisan vault:key
VAULT_ACTIVE_KEY=v1
VAULT_KEY_V1=
