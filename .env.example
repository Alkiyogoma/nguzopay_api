# ── NguzoPay API ────────────────────────────────────────────────
# Copy to .env for local work. Sandbox/production values live in the
# server's secret store, never in git (see docs/04-deployment).
APP_NAME=NguzoPay
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# The Next.js portal (CORS, OAuth/email/reset redirects).
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# IPs of the Next.js server(s) that proxy API calls (they send X-Forwarded-For).
TRUSTED_PROXIES=127.0.0.1,::1

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local quick start uses SQLite. For Postgres (as in CI and production):
#   docker compose up -d   (in this folder), then:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=nguzopay
# DB_USERNAME=nguzopay
# DB_PASSWORD=nguzopay
DB_CONNECTION=sqlite

SESSION_DRIVER=array
FILESYSTEM_DISK=local
KYC_DISK=local

# Queues and cache. With Redis running (docker compose), switch to:
#   QUEUE_CONNECTION=redis  CACHE_STORE=redis  and run `php artisan horizon`.
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@nguzopay.co.tz"
MAIL_FROM_NAME="NguzoPay"

# ── Authentication ─────────────────────────────────────────────
AUTH_TOKEN_TTL_MINUTES=10080
OTP_TTL_MINUTES=5

# Google: https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: ${APP_URL}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers (OAuth App)
#   Callback URL: ${APP_URL}/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── SMS (DarSMS) ────────────────────────────────────────────────
# "log" writes SMS (including OTP codes) to storage/logs/laravel.log.
# "darsms" sends for real. Try it with: php artisan nguzopay:sms-test 07XXXXXXXX
SMS_DRIVER=log
# Must be a sender ID approved on your DarSMS account. Until NGUZOPAY is
# approved, use one that is (DarSMS's sample uses DARSMS).
SMS_DEFAULT_SENDER_ID=NGUZOPAY
DARSMS_BASE_URL=https://dev.darsms.co.tz/api/v1
# Secret: keep it in .env / the server's secret store, never in git or chat.
DARSMS_API_KEY=
# api_key → "X-API-Key: <key>" (DarSMS sample)  |  bearer → "Authorization: Bearer <key>"
DARSMS_AUTH=api_key

# ── Secrets vault (provider credentials) ────────────────────────
# Generate with: php artisan vault:key
VAULT_ACTIVE_KEY=v1
VAULT_KEY_V1=

# ── Collections (P1) ────────────────────────────────────────────
# Comma list of enabled providers. "mock" never runs in production.
PAYMENTS_PROVIDERS=mock
PAYMENTS_DEFAULT_PROVIDER=mock
# false only in sandbox: lets unverified businesses test collections.
PAYMENTS_REQUIRE_ACTIVE_BUSINESS=true
PAYMENT_INTENT_TTL_MINUTES=30
# Public HTTPS base providers call back on: {base}/api/v1/webhooks/{provider}
PAYMENTS_WEBHOOK_URL=
# NguzoPay's fee (absorbed by the merchant, D-015): basis points + fixed TZS.
NGUZOPAY_FEE_BPS=0
NGUZOPAY_FEE_FIXED=0
# T+0 sweep cut-off (D-016), East Africa Time.
SETTLEMENT_CUTOFF=15:00

# Snippe (secrets: .env / secret store only)
SNIPPE_BASE_URL=https://api.snippe.sh
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_FALLBACK_EMAIL=

# Azampay (sandbox hosts; production hosts come after Azampay's KYC)
AZAMPAY_AUTH_URL=https://authenticator-sandbox.azampay.co.tz
AZAMPAY_BASE_URL=https://sandbox.azampay.co.tz
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
# Optional: pin the callback public key (PEM, \n for newlines); otherwise fetched daily.
AZAMPAY_PUBLIC_KEY=
AZAMPAY_SIGNATURE_FIELDS=utilityref,externalreference,transactionstatus,operator
# Callback has no fee: estimate in basis points until provider statements (P4).
AZAMPAY_FEE_BPS=0

# Selcom Checkout (vendor/till, API key and secret come from Selcom; never commit real values)
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_VENDOR=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_WEBHOOK_SECRET=
SELCOM_FALLBACK_EMAIL=
SELCOM_EXPIRY_MINUTES=60
SELCOM_TIMEOUT=20
SELCOM_FEE_BPS=0
# Accept older Snippe callbacks that have no timestamp header (body-only signature).
SNIPPE_ACCEPT_LEGACY_SIGNATURE=true

# CRDB standard bills (CRDB calls us over the VPN: POST /api/v1/billers/crdb)
CRDB_INSTITUTION_ID=
# CRDB's public key: PEM text (\n for newlines) or the path to the .pem file CRDB sends.
CRDB_PUBLIC_KEY=
CRDB_PUBLIC_KEY_PATH=
# CRDB's VPN source addresses, comma-separated. Required outside local.
CRDB_ALLOWED_IPS=
# Credit-account code agreed with CRDB (returned as paymentType).
CRDB_PAYMENT_TYPE=1
CRDB_FEE_BPS=0

# NMB biller (NMB calls us: POST /api/v1/billers/nmb/inquiry and /payment-notification)
# Bearer token agreed with NMB during onboarding (secret: .env only).
NMB_BEARER_TOKEN=
NMB_CLIENT_ID=
NMB_ALLOWED_IPS=
# NguzoPay's NMB collection account and product codes (from NMB).
NMB_COLLECTION_ACCOUNT=
NMB_PRODUCT_CODE=
NMB_BILL_PRODUCT_CODE=001
# 2 = NMB credits our account only after our 600 response.
NMB_PAYMENT_PLAN=2
NMB_MIN_AMOUNT=1000
NMB_BILL_EXPIRY_DAYS=365
NMB_FEE_BPS=0
